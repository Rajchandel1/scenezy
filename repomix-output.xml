        </div>

        <p className="text-neutral-700 text-[10px]">Order: {orderId}</p>
      </div>
    </div>
  );
}

export default function SuccessPage() {
  return (
    <Suspense fallback={<PageLoading message="Confirming your booking…" />}>
      <SuccessContent />
    </Suspense>
  );
}
