  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      const res = await fetch('/api/data/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
