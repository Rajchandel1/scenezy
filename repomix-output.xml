          {dateStr} · {event.time}
        </div>
      </div>
      <div className="p-4 space-y-2">
        <h3 className="text-white font-semibold text-base leading-tight">{event.title}</h3>
        <p className="text-neutral-500 text-xs flex items-center gap-1">
