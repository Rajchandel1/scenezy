type Category={id:string;name:string;active:boolean;sortOrder:number};
type Event={id:string;title:string;category:string;status:string;date:string};
type Layout='FEATURE'|'GRID'|'RAIL'|'COMPACT';
type Section={id:string;title:string;eyebrow:string;layout:Layout;eventIds:string[];active:boolean;sortOrder:number};
const layouts:[Layout,string,typeof Sparkles][]=[['FEATURE','Spotlight',Sparkles],['GRID','Poster grid',LayoutGrid],['RAIL','Swipe rail',Rows3],['COMPACT','Compact list',GripVertical]];
const blankSection:Omit<Section,'id'>={title:'',eyebrow:'',layout:'FEATURE',eventIds:[],active:true,sortOrder:0};

export default function ContentPage(){
  const [categories,setCategories]=useState<Category[]>([]),[events,setEvents]=useState<Event[]>([]),[sections,setSections]=useState<Section[]>([]),[loading,setLoading]=useState(true),[saving,setSaving]=useState(''),[error,setError]=useState('');
  const [categoryName,setCategoryName]=useState(''),[draft,setDraft]=useState<(Omit<Section,'id'>&{id?:string})>(blankSection);
  const [dragging,setDragging]=useState<number|null>(null);
  const {ask,dialog}=useActionDialog();
