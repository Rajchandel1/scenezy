  useEffect(() => {
    if (!sellerId) return;
    setLoaded(false);
    fetch(`/api/data/seller?action=events&sellerId=${sellerId}&tab=${tab}`)
      .then(r => r.json())
      .then(data => { setEvents(data); setLoaded(true); });
  }, [sellerId, tab]);

  const tabs = [
    { id: 'active', label: 'Active' },
    { id: 'pending', label: 'Pending' },
    { id: 'past', label: 'Past' },
    { id: 'all', label: 'All' },
