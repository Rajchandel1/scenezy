        </button>
        <h1 className="text-white text-lg font-bold">My Events</h1>
      </div>

      {/* Tabs */}
      <div className="flex gap-1.5 bg-neutral-900 rounded-xl p-1">
        {tabs.map(t => (
          <button key={t.id} onClick={() => setTab(t.id)}
