              </div>
            </Link>
          ))}
        </div>
      )}
    </div>
  );
}

export default function SellerEventsPage() {
  return (
    <Suspense fallback={<PageLoading message="Opening event studio…" />}>
      <EventsContent />
    </Suspense>
  );
}
