# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Transaction Pooler - Port 6543)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Razorpay (use test keys locally, live keys only in production)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Checkout switch. Use WHATSAPP temporarily; change only this value to
# RAZORPAY after gateway approval. Keep the number in country-code format.
CHECKOUT_MODE=WHATSAPP
WHATSAPP_ORDER_NUMBER=919265461135

# App
APP_URL=http://localhost:3000
